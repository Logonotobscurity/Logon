LOGON_CONTROL_PLANE_API_URL=http://127.0.0.1:4100
# Browser-side dev convenience only. Never enable on a public deployment.
NEXT_PUBLIC_LOGON_CONTROL_PLANE_DEV_MODE=false
NEXT_PUBLIC_LOGON_TENANT_ID=demo

# API-side local development:
# LOGON_CONTROL_PLANE_DEV_MODE=true
# LOGON_CONTROL_PLANE_TENANT_ID=demo
# LOGON_CONTROL_PLANE_ACTOR_ID=developer
# LOGON_CONTROL_PLANE_ROLES=ADMIN

# Production API deployment:
# LOGON_CONTROL_PLANE_TRUSTED_PROXY=true
